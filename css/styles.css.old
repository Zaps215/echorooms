@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap");

:root {
  color-scheme: dark;
  --ink: #f5f7f3;
  --muted: #a2aaa6;
  --subtle: #69736f;
  --canvas: #0f1414;
  --surface: #171d1c;
  --surface-soft: #1d2523;
  --line: rgba(210, 230, 222, .14);
  --line-strong: rgba(140, 229, 210, .38);
  --coral: #ff7661;
  --mint: #9ce8d5;
  --gold: #e8c56d;
  --danger: #ff9589;
  --shadow: rgba(0, 0, 0, .36);
  font-family: "DM Sans", sans-serif;
  color: var(--ink);
  background: var(--canvas);
  font-synthesis: none;
}

* { box-sizing: border-box; }
html, body { min-width: 320px; min-height: 100%; }
body {
  margin: 0;
  background:
    radial-gradient(circle at 10% 5%, rgba(156, 232, 213, .1), transparent 28rem),
    radial-gradient(circle at 90% 95%, rgba(255, 118, 97, .08), transparent 30rem),
    var(--canvas);
}
button, input { font: inherit; }
button { cursor: pointer; }
.is-hidden { display: none !important; }

.auth-shell {
  display: grid;
  grid-template-columns: minmax(260px, 390px) minmax(360px, 460px);
  align-items: center;
  justify-content: center;
  gap: clamp(44px, 8vw, 130px);
  min-height: 100vh;
  padding: 48px;
}
.auth-intro { max-width: 350px; }
.auth-quote {
  margin: 30px 0 26px;
  color: var(--ink);
  font: 600 clamp(40px, 5vw, 64px)/.98 "Space Grotesk", sans-serif;
  letter-spacing: -1.5px;
}
.auth-quote em { color: var(--mint); font-style: normal; }
.auth-note { max-width: 280px; color: var(--muted); line-height: 1.7; }
.auth-signal { display: flex; align-items: end; gap: 5px; height: 34px; margin: 0 0 28px; }
.auth-signal span { width: 5px; border-radius: 4px; background: var(--coral); }
.auth-signal span:nth-child(1) { height: 12px; }
.auth-signal span:nth-child(2) { height: 26px; background: var(--gold); }
.auth-signal span:nth-child(3) { height: 19px; background: var(--mint); }
.auth-panel {
  width: min(100%, 460px);
  padding: clamp(30px, 5vw, 48px);
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(23, 29, 28, .9);
  box-shadow: 0 28px 90px var(--shadow);
  backdrop-filter: blur(20px);
}
.brand-row { display: flex; align-items: center; gap: 12px; margin-bottom: 42px; }
.auth-panel .brand-row { margin-bottom: 56px; }
.brand-mark {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px 5px 12px 5px;
  color: #101514;
  background: var(--coral);
  font: 700 24px "Space Grotesk", sans-serif;
  transform: rotate(-4deg);
}
.eyebrow { margin: 0 0 8px; color: var(--muted); font-size: 10px; letter-spacing: 1.7px; text-transform: uppercase; }
h1, h2, h3, p { margin-top: 0; }
h1 { margin-bottom: 0; font: 700 25px "Space Grotesk", sans-serif; }
h2 { margin-bottom: 0; font: 700 clamp(26px, 3vw, 42px)/1.04 "Space Grotesk", sans-serif; letter-spacing: -.5px; }
h3 { margin-bottom: 8px; font: 700 23px "Space Grotesk", sans-serif; }
.auth-heading h2 { margin-bottom: 14px; }
.auth-heading > p:last-child { max-width: 350px; color: var(--muted); line-height: 1.65; }
.auth-form { display: grid; gap: 9px; margin-top: 30px; }
.auth-form label { color: var(--muted); font-size: 12px; font-weight: 500; }
.auth-form input, .composer input {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid var(--line);
  border-radius: 7px;
  color: var(--ink);
  background: rgba(15, 20, 20, .65);
  transition: border-color .2s ease, box-shadow .2s ease;
}
.auth-form input { margin-bottom: 9px; }
.password-field { position: relative; margin-bottom: 9px; }
.password-field input { margin-bottom: 0; padding-right: 58px; }
.password-toggle { position: absolute; top: 50%; right: 10px; padding: 3px; border: 0; color: var(--muted); background: transparent; font-size: 11px; transform: translateY(-50%); }
.password-toggle:hover { color: var(--ink); }
.auth-form input::placeholder, .composer input::placeholder { color: var(--subtle); }
.auth-form input:focus, .composer input:focus { border-color: var(--mint); outline: none; box-shadow: 0 0 0 3px rgba(156, 232, 213, .12); }
.auth-submit, .composer button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 0;
  border-radius: 7px;
  color: #101514;
  background: var(--mint);
  font-weight: 700;
  transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
}
.auth-submit { margin-top: 8px; padding: 14px 16px; }
.auth-submit:hover, .composer button:hover:not(:disabled) { background: #c2f5e8; box-shadow: 0 8px 20px rgba(156, 232, 213, .12); transform: translateY(-2px); }
.auth-submit:disabled, .sign-out-button:disabled, .delete-account-button:disabled { cursor: wait; opacity: .55; }
.form-message { min-height: 22px; margin: 8px 0 0; color: var(--mint); font-size: 13px; line-height: 1.5; }
.form-message.is-error { color: var(--danger); }
.auth-divider { display: flex; align-items: center; gap: 12px; margin: 25px 0 14px; color: var(--subtle); font-size: 11px; }
.auth-divider::before, .auth-divider::after { content: ""; height: 1px; flex: 1; background: var(--line); }
.google-button { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 13px 16px; border: 1px solid var(--line); border-radius: 7px; color: var(--ink); background: rgba(255, 255, 255, .035); font-weight: 600; transition: border-color .2s ease, background .2s ease, transform .2s ease; }
.google-button:hover { border-color: var(--line-strong); background: rgba(156, 232, 213, .07); transform: translateY(-1px); }
.google-button:disabled { cursor: wait; opacity: .55; }
.google-mark { display: block; width: 21px; height: 21px; flex: 0 0 21px; }
.auth-toggle { display: block; width: 100%; margin-top: 22px; padding: 0; border: 0; color: var(--muted); background: transparent; font-size: 12px; }
.auth-toggle:hover { color: var(--ink); }
.auth-reset { display: block; width: 100%; margin-top: 10px; padding: 0; border: 0; color: var(--subtle); background: transparent; font-size: 11px; }
.auth-reset[hidden] { display: none; }
.auth-reset:hover { color: var(--ink); }

.app-shell { display: grid; grid-template-columns: minmax(230px, .8fr) minmax(420px, 2fr) minmax(230px, .8fr); min-height: 100vh; }
.room-sidebar, .room-info-panel { padding: 30px; background: rgba(13, 18, 18, .72); }
.room-sidebar { border-right: 1px solid var(--line); }
.room-info-panel { border-left: 1px solid var(--line); }
.new-room-button { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 13px 14px; border: 1px solid rgba(255, 118, 97, .52); border-radius: 7px; color: var(--ink); background: rgba(255, 118, 97, .08); font-weight: 600; text-align: left; }
.new-room-button::after { content: "↗"; color: var(--coral); font-size: 17px; }
.new-room-button:hover { color: #121414; background: var(--coral); }
.new-room-button:hover::after { color: #121414; }
.sidebar-section-heading { display: flex; justify-content: space-between; margin-top: 42px; padding-bottom: 13px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: 1.3px; text-transform: uppercase; }
.room-count { color: var(--coral); }
.empty-copy, .panel-copy { color: var(--muted); font-size: 14px; line-height: 1.7; }
.conversation-panel { display: flex; flex-direction: column; min-width: 0; }
.conversation-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; padding: 34px 40px; border-bottom: 1px solid var(--line); background: rgba(14, 19, 19, .44); }
.account-controls { display: flex; align-items: center; gap: 16px; }
.account-actions { display: flex; align-items: center; gap: 12px; padding-left: 16px; border-left: 1px solid var(--line); }
.profile-button, .sign-out-button, .delete-account-button { padding: 7px 0; border: 0; color: var(--muted); background: transparent; font-size: 12px; }
.profile-button:hover, .sign-out-button:hover { color: var(--ink); }
.sign-out-button:hover { color: var(--ink); }
.delete-account-button:hover { color: var(--danger); }
.status-pill { padding: 7px 11px; border: 1px solid rgba(156, 232, 213, .34); border-radius: 999px; color: var(--mint); background: rgba(156, 232, 213, .06); font-size: 11px; font-weight: 600; white-space: nowrap; }
.conversation-empty { display: grid; place-content: center; flex: 1; min-height: 400px; padding: 48px; text-align: center; }
.conversation-empty p { max-width: 330px; margin: 0 auto; color: var(--muted); line-height: 1.7; }
.empty-orbit { display: grid; place-items: center; width: 96px; height: 96px; margin: 0 auto 28px; border: 1px solid rgba(156, 232, 213, .7); border-radius: 50%; box-shadow: 0 0 0 12px rgba(156, 232, 213, .035); }
.empty-orbit span { width: 27px; height: 27px; border-radius: 50%; background: var(--gold); box-shadow: 23px -18px 0 -7px var(--coral); }
.composer { display: flex; gap: 10px; padding: 20px 40px 32px; }
.composer button { min-width: 86px; justify-content: center; padding: 0 18px; }
.composer button:disabled, .composer input:disabled { cursor: not-allowed; opacity: .45; }
.signal-line { display: flex; align-items: center; gap: 9px; margin: 24px 0 12px; font-size: 14px; font-weight: 600; }
.signal-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 4px rgba(232, 197, 109, .1); }
.info-rule { margin: 30px 0; border-top: 1px solid var(--line); }
.next-list { display: grid; gap: 14px; padding-left: 18px; color: var(--muted); font-size: 13px; line-height: 1.4; }
.next-list li::marker { color: var(--coral); }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }

@media (max-width: 900px) { .app-shell { grid-template-columns: 220px 1fr; } .room-info-panel { display: none; } .auth-shell { grid-template-columns: minmax(280px, 460px); gap: 30px; padding: 36px; } .auth-intro { display: grid; grid-template-columns: 1fr auto; column-gap: 24px; max-width: 460px; } .auth-intro .eyebrow, .auth-note { grid-column: 1 / -1; } .auth-quote { margin: 16px 0; } .auth-signal { align-self: end; margin: 0 0 20px; } }
@media (max-width: 620px) { .auth-shell { display: block; padding: 20px; } .auth-intro { display: block; padding: 20px 2px 32px; } .auth-quote { margin: 18px 0; font-size: 40px; } .auth-note { margin-bottom: 0; } .auth-panel { padding: 28px 22px; } .auth-panel .brand-row { margin-bottom: 42px; } .app-shell { display: block; } .room-sidebar { padding: 20px; border-right: 0; border-bottom: 1px solid var(--line); } .brand-row { margin-bottom: 24px; } .sidebar-section-heading { margin-top: 24px; } .conversation-header { padding: 24px 20px; } .account-controls { align-items: flex-end; flex-direction: column; gap: 8px; } .account-actions { padding-left: 0; border-left: 0; } .conversation-empty { min-height: 360px; padding: 30px 20px; } .composer { padding: 16px 20px 22px; } }

.room-list { display: grid; gap: 5px; margin-top: 12px; }
.room-item { display: grid; gap: 3px; width: 100%; padding: 11px 12px; border: 1px solid transparent; border-radius: 7px; color: var(--ink); background: transparent; text-align: left; }
.room-item:hover { background: var(--surface-soft); }
.room-item.is-active { border-color: var(--line); background: var(--surface-soft); }
.room-item-name { overflow: hidden; font-size: 14px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.room-item-type { color: var(--subtle); font-size: 11px; }
.room-dialog { width: min(100% - 32px, 440px); padding: 0; border: 1px solid var(--line-strong); border-radius: 14px; color: var(--ink); background: var(--surface); box-shadow: 0 30px 100px var(--shadow); }
.room-dialog::backdrop { background: rgba(5, 9, 9, .7); backdrop-filter: blur(4px); }
.room-dialog form { display: grid; gap: 10px; padding: 28px; }
.dialog-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.dialog-heading h3 { margin: 0; }
.dialog-close { padding: 0 4px; border: 0; color: var(--muted); background: transparent; font-size: 24px; line-height: 1; }
.dialog-close:hover { color: var(--ink); }
.dialog-copy { color: var(--muted); font-size: 13px; line-height: 1.6; }
.room-dialog label { color: var(--muted); font-size: 12px; font-weight: 500; }
.room-dialog input { width: 100%; padding: 13px 14px; border: 1px solid var(--line); border-radius: 7px; color: var(--ink); background: rgba(15, 20, 20, .65); }
.room-dialog input:focus { border-color: var(--mint); outline: none; box-shadow: 0 0 0 3px rgba(156, 232, 213, .12); }
.profile-dialog { width: min(100% - 32px, 440px); padding: 0; border: 1px solid var(--line-strong); border-radius: 14px; color: var(--ink); background: var(--surface); box-shadow: 0 30px 100px var(--shadow); }
.profile-dialog::backdrop { background: rgba(5, 9, 9, .7); backdrop-filter: blur(4px); }
.profile-dialog form { display: grid; gap: 10px; padding: 28px; }
.profile-dialog label { color: var(--muted); font-size: 12px; font-weight: 500; }
.profile-dialog input { width: 100%; padding: 13px 14px; border: 1px solid var(--line); border-radius: 7px; color: var(--ink); background: rgba(15, 20, 20, .65); }
.profile-dialog input:focus { border-color: var(--mint); outline: none; box-shadow: 0 0 0 3px rgba(156, 232, 213, .12); }
.profile-dialog .password-field input { margin-bottom: 0; }